    {
      "parameters": {
        "jsCode": "const ctx = $input.first().json;\nconst ex = $('Extrair dados1').first().json;\nconst text = ex.text.toLowerCase().trim();\nconst optOutKws = ['sair', 'stop', 'parar', 'cancelar', 'descadastrar'];\nconst isOptOut = optOutKws.some(kw => text === kw || text.startsWith(kw + ' '));\nconst statusMap = {\n  ORDER_RECEIVED: 'Recebido 📋',\n  CONFIRMED: 'Confirmado ✅',\n  IN_PREPARATION: 'Em preparo 🧁',\n  READY: 'Pronto ✅',\n  READY_FOR_PICKUP: 'Pronto para retirada 📦',\n  OUT_FOR_DELIVERY: 'Saiu para entrega 🚗',\n};\nconst d = ctx.data || {};\nconst legacyOrder = d.openOrderRef ? [{ ref: d.openOrderRef, status: d.openOrderStatus }] : [];\nconst openOrders = (Array.isArray(d.openOrders) && d.openOrders.length ? d.openOrders : legacyOrder).map(order => ({\n  ...order,\n  statusLabel: statusMap[order.status] || order.status || 'Em andamento',\n}));\nconst orderStatusMessage = openOrders.length === 1\n  ? 'Seu pedido *' + openOrders[0].ref + '* está com status: *' + openOrders[0].statusLabel + '* 🍰\\n\\nAssim que tiver novidade, você recebe aqui!'\n  : 'Você tem *' + openOrders.length + ' pedidos em aberto* 🍰\\n\\n' + openOrders.map(order => '• *' + order.ref + '* — ' + order.statusLabel).join('\\n') + '\\n\\nAssim que tiver novidade, você recebe aqui!';\nreturn [{ json: {\n  phone: ex.phone,\n  phoneRaw: ex.phoneRaw,\n  text: ex.text,\n  pushName: ex.pushName,\n  exists: d.exists ?? false,\n  hasOpenOrder: openOrders.length > 0,\n  openOrders,\n  orderStatusMessage,\n  consentOrderUpdates: d.consentOrderUpdates ?? false,\n  isOptOut,\n} }];"
      },
