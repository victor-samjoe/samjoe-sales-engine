      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst fromMe = item.data?.key?.fromMe;\nconst remoteJid = item.data?.key?.remoteJid || '';\nif (fromMe === false && !remoteJid.includes('@g.us')) {\n  return [{ json: item }];\n}\nreturn [];"
