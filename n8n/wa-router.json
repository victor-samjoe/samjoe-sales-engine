        "jsCode": "const item = $input.first().json;\nconst remoteJid = item.data?.key?.remoteJid || '';\nconst phoneRaw = remoteJid.split('@')[0];\nconst phone = '+' + phoneRaw;\nconst msg = item.data?.message || {};\nconst text = (msg.conversation || msg.extendedTextMessage?.text || msg.imageMessage?.caption || msg.videoMessage?.caption || '').trim();\nconst pushName = item.data?.pushName || '';\nreturn [{ json: { phone, phoneRaw, text, pushName } }];"
